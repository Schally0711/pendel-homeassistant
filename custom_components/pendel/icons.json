    "button": {
      "start_home": {
        "default": "mdi:home-account"
      },
      "start_office": {
        "default": "mdi:office-building"
      },
      "start_break": {
        "default": "mdi:coffee"
      },
      "end_break": {
        "default": "mdi:coffee-off"
      },
      "stop_work": {
        "default": "mdi:flag-checkered"
      }
    }
